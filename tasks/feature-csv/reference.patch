diff --git a/src/expenses/transfer.py b/src/expenses/transfer.py
new file mode 100644
index 0000000..5e6d675
--- /dev/null
+++ b/src/expenses/transfer.py
@@ -0,0 +1,53 @@
+"""CSV export and import."""
+
+from __future__ import annotations
+
+import csv
+from datetime import date
+from pathlib import Path
+
+from expenses.models import (
+    Expense,
+    ValidationError,
+    format_amount,
+    normalise_category,
+    parse_amount,
+    parse_date,
+)
+
+FIELDS = ["date", "amount", "category", "note"]
+
+
+def export_csv(expenses: list[Expense], path: Path) -> None:
+    with path.open("w", newline="", encoding="utf-8") as f:
+        writer = csv.writer(f)
+        writer.writerow(FIELDS)
+        for e in expenses:
+            writer.writerow([e.date.isoformat(), format_amount(e.amount_pence), e.category, e.note])
+
+
+def read_csv(path: Path) -> list[tuple[date, int, str, str]]:
+    """Parse every row, or raise ValidationError naming each bad line."""
+    try:
+        with path.open(newline="", encoding="utf-8") as f:
+            reader = csv.DictReader(f)
+            if reader.fieldnames != FIELDS:
+                raise ValidationError(f"expected the header {','.join(FIELDS)}")
+            rows, errors = [], []
+            for row in reader:
+                try:
+                    rows.append(
+                        (
+                            parse_date(row["date"] or ""),
+                            parse_amount(row["amount"] or ""),
+                            normalise_category(row["category"] or ""),
+                            (row["note"] or "").strip(),
+                        )
+                    )
+                except ValidationError as exc:
+                    errors.append(f"line {reader.line_num}: {exc}")
+    except OSError as exc:
+        raise ValidationError(f"cannot read {path}: {exc}") from exc
+    if errors:
+        raise ValidationError("nothing imported; invalid rows:\n  " + "\n  ".join(errors))
+    return rows
