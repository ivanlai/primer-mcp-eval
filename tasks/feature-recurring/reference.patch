+    def _append(self, when: date, amount_pence: int, category: str, note: str) -> Expense:
         expense = Expense(
             id=self._next_id,
             date=when,
@@ -61,9 +82,29 @@ class ExpenseStore:
         )
         self._expenses.append(expense)
         self._next_id += 1
-        self._save()
         return expense
 
+    def add_recurring(self, amount_pence: int, category: str, day: int, note: str = "") -> None:
+        self._recurring.append(Recurring(amount_pence, category, day, note))
+        self._save()
+
+    def recurring(self) -> list[Recurring]:
+        return list(self._recurring)
+
+    def apply_recurring(self, year: int, month: int) -> list[Expense]:
+        """Add this month's recurring expenses once; later calls for the month add nothing."""
+        key = f"{year:04d}-{month:02d}"
+        last_day = calendar.monthrange(year, month)[1]
+        added = []
+        for rule in self._recurring:
+            if key in rule.applied_months:
+                continue
+            when = date(year, month, min(rule.day, last_day))
+            added.append(self._append(when, rule.amount_pence, rule.category, rule.note))
+            rule.applied_months.append(key)
+        self._save()
+        return added
+
     def all(self) -> list[Expense]:
         """Every expense, oldest first (ties broken by id)."""
         return sorted(self._expenses, key=lambda e: (e.date, e.id))
