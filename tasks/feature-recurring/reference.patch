--- a/src/expenses/cli.py
+++ b/src/expenses/cli.py
@@ -1,4 +1,4 @@
-"""Command-line interface: expenses add | list | categories | summary."""
+"""Command-line interface: expenses add | list | categories | summary | recurring."""
 
 from __future__ import annotations
 
@@ -45,6 +45,17 @@ def build_parser() -> argparse.ArgumentParser:
     summary = sub.add_parser("summary", help="summarise one month")
     summary.add_argument("month", help="month as YYYY-MM")
 
+    recurring = sub.add_parser("recurring", help="manage monthly recurring expenses")
+    rec_sub = recurring.add_subparsers(dest="recurring_command", required=True)
+    rec_add = rec_sub.add_parser("add", help="record a monthly recurring expense")
+    rec_add.add_argument("amount", help="amount, e.g. 950")
+    rec_add.add_argument("category", help="category, e.g. rent")
+    rec_add.add_argument("--day", type=int, required=True, help="day of the month (1-31)")
+    rec_add.add_argument("--note", default="", help="free-text note")
+    rec_sub.add_parser("list", help="show recurring expenses")
+    rec_apply = rec_sub.add_parser("apply", help="add a month's recurring expenses")
+    rec_apply.add_argument("month", help="month as YYYY-MM")
+
     return parser
 
 
@@ -105,11 +116,38 @@ def cmd_summary(store: ExpenseStore, args: argparse.Namespace) -> int:
     return 0
 
 
+def cmd_recurring(store: ExpenseStore, args: argparse.Namespace) -> int:
+    if args.recurring_command == "add":
+        if not 1 <= args.day <= 31:
+            raise ValidationError("day must be between 1 and 31")
+        amount = parse_amount(args.amount)
+        category = normalise_category(args.category)
+        store.add_recurring(amount, category, args.day, args.note.strip())
+        print(f"Recurring: {format_amount(amount)} {category} on day {args.day} of each month")
+        return 0
+    if args.recurring_command == "apply":
+        year, month = parse_month(args.month)
+        added = store.apply_recurring(year, month)
+        print(f"Added {len(added)} recurring expense(s) for {year:04d}-{month:02d}")
+        return 0
+    rules = store.recurring()
+    if not rules:
+        print("No recurring expenses.")
+        return 0
+    for rule in rules:
+        line = f"day {rule.day:>2}  {format_amount(rule.amount_pence):>10}  {rule.category}"
+        if rule.note:
+            line += f"  ({rule.note})"
+        print(line)
+    return 0
+
+
 COMMANDS = {
     "add": cmd_add,
     "list": cmd_list,
     "categories": cmd_categories,
     "summary": cmd_summary,
+    "recurring": cmd_recurring,
 }
 
 
