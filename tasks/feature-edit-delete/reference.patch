 import json
 import os
+from dataclasses import replace
 from datetime import date
 from pathlib import Path
 
@@ -17,6 +18,10 @@ class StorageError(Exception):
     """Raised when the data file exists but cannot be read."""
 
 
+class NotFoundError(Exception):
+    """Raised when no expense has the given id."""
+
+
 def default_path() -> Path:
     override = os.environ.get(ENV_VAR)
     return Path(override) if override else DEFAULT_PATH
@@ -64,6 +69,23 @@ class ExpenseStore:
         self._save()
         return expense
 
+    def _index(self, expense_id: int) -> int:
+        for i, expense in enumerate(self._expenses):
+            if expense.id == expense_id:
+                return i
+        raise NotFoundError(f"no expense with id {expense_id}")
+
+    def delete(self, expense_id: int) -> Expense:
+        expense = self._expenses.pop(self._index(expense_id))
+        self._save()
+        return expense
+
+    def update(self, expense_id: int, **changes) -> Expense:
+        i = self._index(expense_id)
+        self._expenses[i] = replace(self._expenses[i], **changes)
+        self._save()
+        return self._expenses[i]
+
     def all(self) -> list[Expense]:
         """Every expense, oldest first (ties broken by id)."""
         return sorted(self._expenses, key=lambda e: (e.date, e.id))
