+def render_summary(summary: MonthSummary) -> str:
+    """The text of the summary command for one month."""
+    lines = [f"Summary for {summary.year:04d}-{summary.month:02d}"]
+    if not summary.count:
+        lines.append("No expenses this month.")
+        return "\n".join(lines) + "\n"
+    lines.append(f"Total:          {format_amount(summary.total_pence)} ({summary.count} expenses)")
+    lines.append(f"Daily average:  {format_amount(summary.daily_average_pence)}")
+    lines.append("By category:")
+    for item in summary.by_category:
+        lines.append(
+            f"  {item.category:<16} {format_amount(item.total_pence):>10}"
+            f"  {item.share_percent:>3}%  ({item.count})"
+        )
+    return "\n".join(lines) + "\n"
